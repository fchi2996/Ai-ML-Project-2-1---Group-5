# Ignore everything by default
*

# Allow only what the Dockerfile COPYs
!constraints.txt
!ml-agents/csv-plugin
!ml-agents/config
!ml-agents/Project/Automation/src/MLAgentLauncher.java
!ml-agents/Project/Automation/randomizer/*.py
!app_Builds/3dballLinux
!app_Builds/3dballLinux_il2cpp

# Junk inside allowed folders
**/__pycache__
**/*.pyc
**/.DS_Store